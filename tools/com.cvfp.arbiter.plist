<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cvfp.arbiter</string>
    <!-- UNICO proprietario del lettore ControlVault: demone/sudo/GUI gli parlano
         via /tmp/cvfp-arbiter.sock invece di aprire il lettore ciascuno. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/amoslobianco/usbcfg/tools/fparbiterd.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/Users/amoslobianco/usbcfg/controlvault/fparbiter.log</string>
    <key>StandardOutPath</key>
    <string>/Users/amoslobianco/usbcfg/controlvault/fparbiter.log</string>
</dict>
</plist>
