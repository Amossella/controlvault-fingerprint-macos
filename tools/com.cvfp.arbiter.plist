<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- MODELLO: __PYTHON__ e __ROOT__ sono sostituiti da install_unlock_agent.sh -->
    <key>Label</key>
    <string>com.cvfp.arbiter</string>
    <!-- UNICO proprietario del lettore ControlVault: demone/sudo/GUI gli parlano
         via controlvault/arbiter.sock invece di aprire il lettore ciascuno. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__ROOT__/tools/fparbiterd.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__ROOT__/controlvault/fparbiter.log</string>
    <key>StandardOutPath</key>
    <string>__ROOT__/controlvault/fparbiter.log</string>
</dict>
</plist>
